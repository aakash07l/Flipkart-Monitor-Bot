[Unit]
Description=Flipkart PlayStation Stock Monitor Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/flipkart-bot
ExecStart=/home/ubuntu/flipkart-bot/venv/bin/python main.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=TELEGRAM_BOT_TOKEN=9094805444:AAElcttCMQYvLcny-tttmveiK3CTyydyqfY
Environment=CHECK_INTERVAL_SECONDS=90

[Install]
WantedBy=multi-user.target
